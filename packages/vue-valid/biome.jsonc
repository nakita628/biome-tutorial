    {
      "includes": ["**/src/nursery/useVueConsistentDefinePropsDeclaration/default/**"],
      "linter": { "enabled": true, "rules": { "nursery": { "useVueConsistentDefinePropsDeclaration": "error" } } }
    },

    // useVueNextTickPromise — Enforces Promise syntax when using Vue `nextTick`.
    //   縛る対象 : src/nursery/useVueNextTickPromise/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/nursery/useVueNextTickPromise を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし ・ ドメイン vue
