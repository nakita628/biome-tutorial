    {
      "includes": ["**/src/nursery/useVueNextTickPromise/default/**"],
      "linter": { "enabled": true, "rules": { "nursery": { "useVueNextTickPromise": "error" } } }
    },

    // useVueValidVFor — Enforces valid `v-for` directives in Vue templates.
    //   縛る対象 : src/nursery/useVueValidVFor/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/nursery/useVueValidVFor を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし ・ ドメイン vue
