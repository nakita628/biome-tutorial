    {
      "includes": ["**/src/style/useVueConsistentVBindStyle/default/**"],
      "linter": { "enabled": true, "rules": { "style": { "useVueConsistentVBindStyle": "error" } } }
    },

    // useVueConsistentVBindStyle — Enforce a consistent style for `v-bind` in Vue templates.
    //   縛る対象 : src/style/useVueConsistentVBindStyle/options-1/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/style/useVueConsistentVBindStyle を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正 unsafe ・ ドメイン vue
    //   オプション: 既定ではなく下の "options" の設定で検証する
