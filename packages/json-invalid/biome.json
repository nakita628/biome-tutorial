{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "preset": "none",
      "nursery": {
        "noBaseToString": "off",
        "noFloatingPromises": "off",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noUndeclaredClasses": "off",
        "noUnsafePlusOperands": "off",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "useAwaitThenable": "off",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "off",
        "useIncludes": "off",
        "useNullishCoalescing": "off",
        "useRegexpExec": "off",
        "useStringStartsEndsWith": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      },
      "correctness": {
        "noPrivateImports": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off"
      },
      "complexity": {
        "useArrayFind": "off"
      },
      "style": {
        "useConsistentEnumValueType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/correctness/noUndeclaredDependencies/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noUndeclaredDependencies/options-2/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": {
              "level": "error",
              "options": {
                "devDependencies": [
                  "**/tests/*.test.js",
                  "**/tests/*.spec.js"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noEmptyObjectKeys/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noEmptyObjectKeys": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noTopLevelLiterals/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noTopLevelLiterals": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/useReactCompiler/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "useReactCompiler": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/useReactCompiler/options-1/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "useReactCompiler": {
              "level": "error",
              "options": {
                "compilationMode": "all"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/source/useSortedPackageJson/default/**"
      ],
      "assist": {
        "enabled": true,
        "actions": {
          "source": {
            "useSortedPackageJson": "on"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noQuickfixBiome/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noQuickfixBiome": "error"
          }
        }
      }
    }
  ]
}
