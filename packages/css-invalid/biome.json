          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noUnknownPseudoElement/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUnknownPseudoElement": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noUnknownTypeSelector/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUnknownTypeSelector": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noUnknownUnit/default/**"
      ],
      "linter": {
