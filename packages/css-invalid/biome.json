{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "preset": "none",
      "nursery": {
        "noBaseToString": "off",
        "noFloatingPromises": "off",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noUndeclaredClasses": "off",
        "noUnsafePlusOperands": "off",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "useAwaitThenable": "off",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "off",
        "useIncludes": "off",
        "useNullishCoalescing": "off",
        "useRegexpExec": "off",
        "useStringStartsEndsWith": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      },
      "correctness": {
        "noPrivateImports": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off"
      },
      "complexity": {
        "useArrayFind": "off"
      },
      "style": {
        "useConsistentEnumValueType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/a11y/useGenericFontNames/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "a11y": {
            "useGenericFontNames": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/complexity/noImportantStyles/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "complexity": {
            "noImportantStyles": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noInvalidDirectionInLinearGradient/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noInvalidDirectionInLinearGradient": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noInvalidGridAreas/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noInvalidGridAreas": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noInvalidPositionAtImportRule/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noInvalidPositionAtImportRule": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noMissingVarFunction/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noMissingVarFunction": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noUnknownFunction/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUnknownFunction": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/correctness/noUnknownMediaFeatureName/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
