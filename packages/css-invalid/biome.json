      }
    },
    {
      "includes": [
        "**/src/suspicious/noDuplicateFontNames/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noDuplicateFontNames": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noDuplicateProperties/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noDuplicateProperties": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noDuplicateSelectorsKeyframeBlock/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noDuplicateSelectorsKeyframeBlock": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noEmptyBlock/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noEmptyBlock": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noImportantInKeyframe/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noImportantInKeyframe": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noShorthandPropertyOverrides/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noShorthandPropertyOverrides": "error"
          }
