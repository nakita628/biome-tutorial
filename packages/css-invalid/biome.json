    },
    {
      "includes": [
        "**/src/nursery/useBaseline/options-1/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "useBaseline": {
              "level": "error",
              "options": {
                "available": "newly"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/useNamedLayer/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
