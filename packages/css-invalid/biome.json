        "**/src/correctness/noUnmatchableAnbSelector/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUnmatchableAnbSelector": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noDuplicateSelectors/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noDuplicateSelectors": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noExcessiveSelectorClasses/options-1/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noExcessiveSelectorClasses": {
              "level": "error",
              "options": {
                "maxClasses": 1
