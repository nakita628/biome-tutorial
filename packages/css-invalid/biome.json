          "nursery": {
            "noExcessiveSelectorClasses": {
              "level": "error",
              "options": {
                "maxClasses": 2
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noInvalidPropertyInitValue/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noInvalidPropertyInitValue": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noUnusedClasses/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noUnusedClasses": "error"
          }
