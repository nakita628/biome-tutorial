            "noDeprecatedMediaType": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noDuplicateAtImportRules/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noDuplicateAtImportRules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noDuplicateCustomProperties/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
