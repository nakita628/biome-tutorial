{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "useArrayFind": "off"
      },
      "correctness": {
        "noPrivateImports": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off"
      },
      "nursery": {
        "noBaseToString": "off",
        "noFloatingPromises": "off",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noUndeclaredClasses": "off",
        "noUnsafePlusOperands": "off",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "useAwaitThenable": "off",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "off",
        "useIncludes": "off",
        "useNullishCoalescing": "off",
        "useRegexpExec": "off",
        "useStringStartsEndsWith": "off"
      },
      "style": {
        "useConsistentEnumValueType": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/nursery/noEmptyObjectKeys/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noEmptyObjectKeys": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/nursery/noTopLevelLiterals/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "nursery": {
            "noTopLevelLiterals": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/style/useDestructuring/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "style": {
            "useDestructuring": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/style/useFilenamingConvention/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "style": {
            "useFilenamingConvention": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/style/useSelfClosingElements/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "style": {
            "useSelfClosingElements": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noDoubleEquals/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noDoubleEquals": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/noDuplicateDependencies/default/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "noDuplicateDependencies": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/suspicious/useRequiredScripts/options-1/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "suspicious": {
            "useRequiredScripts": {
              "level": "error",
              "options": {
                "requiredScripts": [
                  "test",
                  "build"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/source/useSortedPackageJson/default/**"
      ],
      "assist": {
        "enabled": true,
        "actions": {
          "source": {
            "useSortedPackageJson": "on"
          }
        }
      }
    }
  ]
}
