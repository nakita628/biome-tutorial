    {
      "includes": ["**/src/complexity/noUselessContinue/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessContinue": "error" } } }
    },

    // noUselessEmptyExport — Disallow empty exports that don't change anything in a module file.
    //   縛る対象 : src/complexity/noUselessEmptyExport/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noUselessEmptyExport を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-useless-empty-export/
    {
      "includes": ["**/src/complexity/noUselessEmptyExport/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessEmptyExport": "error" } } }
    },

    // noUselessEscapeInRegex — Disallow unnecessary escape sequence in regular expression literals.
    //   縛る対象 : src/complexity/noUselessEscapeInRegex/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/complexity/noUselessEscapeInRegex を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-useless-escape-in-regex/
    {
      "includes": ["**/src/complexity/noUselessEscapeInRegex/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessEscapeInRegex": "error" } } }
    },

    // noUselessLabel — Disallow unnecessary labels.
    //   縛る対象 : src/complexity/noUselessLabel/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noUselessLabel を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-useless-label/
    {
      "includes": ["**/src/complexity/noUselessLabel/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessLabel": "error" } } }
    },

