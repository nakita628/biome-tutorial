                "paths": {
                  "lodash": "Using lodash is not encouraged.",
                  "underscore": "",
                  "import-foo": { "importNames": ["Bar"] },
                  "import-bar": { "allowImportNames": ["Bar"] }
                },
                "patterns": [{ "group": ["import-foo/*", "!import-foo/bar"] }]
              }
            }
          }
        }
      }
    },

