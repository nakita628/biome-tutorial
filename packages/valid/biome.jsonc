/**
 * @biome-tutorial/valid の Biome 設定
 * tools/generate.mjs が生成しています。直接編集しないでください。
 *
 * ■ このパッケージが保証すること
 *     biome check がかならず成功する (診断が 1 件も出ない)
 *
 * ■ 何を有効にしているか
 *     - 既定ではルールを 1 つも有効にしない      … linter.rules.preset: "none"
 *     - ディレクトリごとに 1 ルールだけ有効にする … overrides[]
 *     - 有効化しているルール: 339 種類 / override: 386 件
 *     - 検証しているケース  : 825 件 (839 ファイル)
 *
 * ■ 何を縛っているか
 *     overrides[].includes に書いたディレクトリだけが、そのルールの検査対象になります。
 *     1 ディレクトリ = 1 ルールなので、「そのルールから見て問題のないコード」だけを集められます。
 *
 * ■ 内訳 (グループごとの override 件数)
 *     a11y           1 件
 *     complexity    52 件
 *     correctness   53 件
 *     nursery       76 件
 *     performance    8 件
 *     security       2 件
 *     source         4 件
 *     style         97 件
 *     suspicious    93 件
 */
{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",

  // このファイルはプロジェクトのルートではなく、ルートの biome.jsonc を継承する。
  "root": false,
  "extends": "//",

  "linter": {
    "rules": {
      // 既定ではどのルールも有効にしない。ここから下の overrides で 1 つずつ有効化する。
      "preset": "none",

      // ここから下は「打ち消し」の設定です。
      // ルートの biome.jsonc で linter.domains の project / types を "all" にしているのは、
      // プロジェクトスキャナと型推論という *機能* を立ち上げるためです
      // (overrides でルールを有効にしただけでは、これらの機能は動きません)。
      // ただしそのままだと該当ドメインのルールが全 fixture に混入してしまうため、
      // ここで明示的に "off" にして黙らせています。
      // 明示的な "off" は domains の "all" より優先され、さらに overrides の "error" が最優先です。
      "nursery": {
        "noBaseToString": "off",
        "noFloatingPromises": "off",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noUndeclaredClasses": "off",
        "noUnsafePlusOperands": "off",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "useAwaitThenable": "off",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "off",
        "useIncludes": "off",
        "useNullishCoalescing": "off",
        "useRegexpExec": "off",
        "useStringStartsEndsWith": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      },
      "correctness": {
        "noPrivateImports": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off"
      },
      "complexity": {
        "useArrayFind": "off"
      },
      "style": {
        "useConsistentEnumValueType": "off"
      },
    }
  },

  // ここから下が「どのディレクトリでどのルールを有効にするか」の一覧です。
  "overrides": [
    // ══════════════════════════════════════════════════════════════════════════
    // a11y — override 1 件
    // ══════════════════════════════════════════════════════════════════════════
    // noPositiveTabindex — Prevent the usage of positive integers on `tabIndex` property
    //   縛る対象 : src/a11y/noPositiveTabindex/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/a11y/noPositiveTabindex を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-positive-tabindex/
    {
      "includes": ["**/src/a11y/noPositiveTabindex/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noPositiveTabindex": "error" } } }
    },

    // ══════════════════════════════════════════════════════════════════════════
    // complexity — override 52 件
    // ══════════════════════════════════════════════════════════════════════════
    // noAdjacentSpacesInRegex — Disallow unclear usage of consecutive space characters in regular expression literals
    //   縛る対象 : src/complexity/noAdjacentSpacesInRegex/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/complexity/noAdjacentSpacesInRegex を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-adjacent-spaces-in-regex/
    {
      "includes": ["**/src/complexity/noAdjacentSpacesInRegex/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noAdjacentSpacesInRegex": "error" } } }
    },

    // noArguments — Disallow the use of `arguments`.
    //   縛る対象 : src/complexity/noArguments/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noArguments を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-arguments/
    {
      "includes": ["**/src/complexity/noArguments/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noArguments": "error" } } }
    },

    // noBannedTypes — Disallow primitive type aliases and misleading types.
    //   縛る対象 : src/complexity/noBannedTypes/default/ 配下 (11 ケース / 11 ファイル)
    //   有効化   : lint/complexity/noBannedTypes を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-banned-types/
    {
      "includes": ["**/src/complexity/noBannedTypes/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noBannedTypes": "error" } } }
    },

    // noCommaOperator — Disallow comma operator.
    //   縛る対象 : src/complexity/noCommaOperator/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noCommaOperator を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-comma-operator/
    {
      "includes": ["**/src/complexity/noCommaOperator/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noCommaOperator": "error" } } }
    },

    // noDivRegex — Disallow equal signs explicitly at the beginning of regular expressions.
    //   縛る対象 : src/complexity/noDivRegex/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noDivRegex を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-div-regex/
    {
      "includes": ["**/src/complexity/noDivRegex/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noDivRegex": "error" } } }
    },

    // noEmptyTypeParameters — Disallow empty type parameters in type aliases and interfaces.
    //   縛る対象 : src/complexity/noEmptyTypeParameters/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/complexity/noEmptyTypeParameters を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-empty-type-parameters/
    {
      "includes": ["**/src/complexity/noEmptyTypeParameters/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noEmptyTypeParameters": "error" } } }
    },

    // noExcessiveCognitiveComplexity — Disallow functions that exceed a given Cognitive Complexity score.
    //   縛る対象 : src/complexity/noExcessiveCognitiveComplexity/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noExcessiveCognitiveComplexity を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし
    //   補足     : 公式ドキュメントにコード例が無いため tools/config.mjs で手書きしたケース
    //   ドキュメント: https://biomejs.dev/linter/rules/no-excessive-cognitive-complexity/
    {
      "includes": ["**/src/complexity/noExcessiveCognitiveComplexity/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noExcessiveCognitiveComplexity": "error" } } }
    },

    // noExcessiveLinesPerFunction — Restrict the number of lines of code in a function.
    //   縛る対象 : src/complexity/noExcessiveLinesPerFunction/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/complexity/noExcessiveLinesPerFunction を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-excessive-lines-per-function/
    {
      "includes": ["**/src/complexity/noExcessiveLinesPerFunction/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noExcessiveLinesPerFunction": "error" } } }
    },

    // noExcessiveLinesPerFunction — Restrict the number of lines of code in a function.
    //   縛る対象 : src/complexity/noExcessiveLinesPerFunction/options-2/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noExcessiveLinesPerFunction を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし
    //   オプション: 既定ではなく下の "options" の設定で検証する
    //   ドキュメント: https://biomejs.dev/linter/rules/no-excessive-lines-per-function/
    {
      "includes": ["**/src/complexity/noExcessiveLinesPerFunction/options-2/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 2, "skipBlankLines": true } }
          }
        }
      }
    },

    // noExcessiveLinesPerFunction — Restrict the number of lines of code in a function.
    //   縛る対象 : src/complexity/noExcessiveLinesPerFunction/options-3/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noExcessiveLinesPerFunction を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし
    //   オプション: 既定ではなく下の "options" の設定で検証する
    //   ドキュメント: https://biomejs.dev/linter/rules/no-excessive-lines-per-function/
    {
      "includes": ["**/src/complexity/noExcessiveLinesPerFunction/options-3/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 2, "skipIifes": true } }
          }
        }
      }
    },

    // noExcessiveNestedTestSuites — This rule enforces a maximum depth to nested `describe()` in test files.
    //   縛る対象 : src/complexity/noExcessiveNestedTestSuites/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noExcessiveNestedTestSuites を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし ・ ドメイン test
    //   ドキュメント: https://biomejs.dev/linter/rules/no-excessive-nested-test-suites/
    {
      "includes": ["**/src/complexity/noExcessiveNestedTestSuites/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noExcessiveNestedTestSuites": "error" } } }
    },

    // noExtraBooleanCast — Disallow unnecessary boolean casts
    //   縛る対象 : src/complexity/noExtraBooleanCast/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noExtraBooleanCast を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-extra-boolean-cast/
    {
      "includes": ["**/src/complexity/noExtraBooleanCast/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noExtraBooleanCast": "error" } } }
    },

    // noFlatMapIdentity — Disallow to use unnecessary callback on `flatMap`.
    //   縛る対象 : src/complexity/noFlatMapIdentity/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noFlatMapIdentity を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-flat-map-identity/
    {
      "includes": ["**/src/complexity/noFlatMapIdentity/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noFlatMapIdentity": "error" } } }
    },

    // noForEach — Prefer `for...of` statement instead of `Array.forEach`.
    //   縛る対象 : src/complexity/noForEach/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/complexity/noForEach を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ではない ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-for-each/
    {
      "includes": ["**/src/complexity/noForEach/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noForEach": "error" } } }
    },

    // noForEach — Prefer `for...of` statement instead of `Array.forEach`.
    //   縛る対象 : src/complexity/noForEach/options-1/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noForEach を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ではない ・ 自動修正なし
    //   オプション: 既定ではなく下の "options" の設定で検証する
    //   ドキュメント: https://biomejs.dev/linter/rules/no-for-each/
    {
      "includes": ["**/src/complexity/noForEach/options-1/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "complexity": { "noForEach": { "level": "error", "options": { "allowedIdentifiers": ["Effect", "_"] } } }
        }
      }
    },

    // noImplicitCoercions — Encourage use of explicit type conversion functions over their shorthand counterparts.
    //   縛る対象 : src/complexity/noImplicitCoercions/default/ 配下 (7 ケース / 7 ファイル)
    //   有効化   : lint/complexity/noImplicitCoercions を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-implicit-coercions/
    {
      "includes": ["**/src/complexity/noImplicitCoercions/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noImplicitCoercions": "error" } } }
    },

    // noImplicitCoercions — Encourage use of explicit type conversion functions over their shorthand counterparts.
    //   縛る対象 : src/complexity/noImplicitCoercions/options-1/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noImplicitCoercions を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正 unsafe
    //   オプション: 既定ではなく下の "options" の設定で検証する
    //   ドキュメント: https://biomejs.dev/linter/rules/no-implicit-coercions/
    {
      "includes": ["**/src/complexity/noImplicitCoercions/options-1/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "complexity": { "noImplicitCoercions": { "level": "error", "options": { "allowDoubleNegation": true } } }
        }
      }
    },

    // noRedundantDefaultExport — Checks if a default export exports the same symbol as a named export.
    //   縛る対象 : src/complexity/noRedundantDefaultExport/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noRedundantDefaultExport を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ではない ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-redundant-default-export/
    {
      "includes": ["**/src/complexity/noRedundantDefaultExport/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noRedundantDefaultExport": "error" } } }
    },

    // noStaticOnlyClass — This rule reports when a class has no non-static members, such as for a class used exclusively as a static namespace.
    //   縛る対象 : src/complexity/noStaticOnlyClass/default/ 配下 (4 ケース / 4 ファイル)
    //   有効化   : lint/complexity/noStaticOnlyClass を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-static-only-class/
    {
      "includes": ["**/src/complexity/noStaticOnlyClass/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noStaticOnlyClass": "error" } } }
    },

    // noThisInStatic — Disallow `this` and `super` in `static` contexts.
    //   縛る対象 : src/complexity/noThisInStatic/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/complexity/noThisInStatic を "error" にする
    //   ルール情報: 既定の重大度 warn ・ recommended ・ 自動修正 safe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-this-in-static/
    {
      "includes": ["**/src/complexity/noThisInStatic/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noThisInStatic": "error" } } }
    },

    // noUselessCatch — Disallow unnecessary `catch` clauses.
    //   縛る対象 : src/complexity/noUselessCatch/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/complexity/noUselessCatch を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-useless-catch/
    {
      "includes": ["**/src/complexity/noUselessCatch/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessCatch": "error" } } }
    },

    // noUselessCatchBinding — Disallow unused catch bindings.
    //   縛る対象 : src/complexity/noUselessCatchBinding/default/ 配下 (4 ケース / 4 ファイル)
    //   有効化   : lint/complexity/noUselessCatchBinding を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-useless-catch-binding/
    {
      "includes": ["**/src/complexity/noUselessCatchBinding/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessCatchBinding": "error" } } }
    },

    // noUselessConstructor — Disallow unnecessary constructors.
    //   縛る対象 : src/complexity/noUselessConstructor/default/ 配下 (5 ケース / 5 ファイル)
    //   有効化   : lint/complexity/noUselessConstructor を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-useless-constructor/
    {
      "includes": ["**/src/complexity/noUselessConstructor/default/**"],
      "linter": { "enabled": true, "rules": { "complexity": { "noUselessConstructor": "error" } } }
    },

    // noUselessContinue — Avoid using unnecessary `continue`.
    //   縛る対象 : src/complexity/noUselessContinue/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/complexity/noUselessContinue を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ・ 自動修正 safe
