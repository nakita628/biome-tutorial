      "linter": { "enabled": true, "rules": { "a11y": { "noNoninteractiveElementToInteractiveRole": "error" } } }
    },

    // noNoninteractiveTabindex — Enforce that `tabIndex` is not assigned to non-interactive HTML elements.
    //   縛る対象 : src/a11y/noNoninteractiveTabindex/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/a11y/noNoninteractiveTabindex を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-noninteractive-tabindex/
    {
      "includes": ["**/src/a11y/noNoninteractiveTabindex/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noNoninteractiveTabindex": "error" } } }
    },

