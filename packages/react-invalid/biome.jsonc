    //   縛る対象 : src/a11y/noPositiveTabindex/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/a11y/noPositiveTabindex を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-positive-tabindex/
    {
      "includes": ["**/src/a11y/noPositiveTabindex/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noPositiveTabindex": "error" } } }
    },

    // noRedundantAlt — Enforce `img` alt prop does not contain the word "image", "picture", or "photo".
    //   縛る対象 : src/a11y/noRedundantAlt/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/a11y/noRedundantAlt を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正なし
