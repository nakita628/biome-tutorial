    },

    // noNoninteractiveElementToInteractiveRole — Enforce that interactive ARIA roles are not assigned to non-interactive HTML elements.
    //   縛る対象 : src/a11y/noNoninteractiveElementToInteractiveRole/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/a11y/noNoninteractiveElementToInteractiveRole を "error" にする
