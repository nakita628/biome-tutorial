/**
 * @biome-tutorial/react-invalid の Biome 設定
 * tools/generate.mjs が生成しています。直接編集しないでください。
 *
 * ■ このパッケージが保証すること
 *     biome check がかならず失敗する (しかも有効にしたルールの診断しか出ない)
 *
 * ■ 何を有効にしているか
 *     - 既定ではルールを 1 つも有効にしない      … linter.rules.preset: "none"
 *     - ディレクトリごとに 1 ルールだけ有効にする … overrides[]
 *     - 有効化しているルール: 104 種類 / override: 117 件
 *     - 検証しているケース  : 261 件 (267 ファイル)
 *
 * ■ 何を縛っているか
 *     overrides[].includes に書いたディレクトリだけが、そのルールの検査対象になります。
 *     1 ディレクトリ = 1 ルールなので、「そのルールの診断が出た」ことと「他のルールの診断が出ていない」ことを同時に検証できます。
 *
 * ■ 内訳 (グループごとの override 件数)
 *     a11y          38 件
 *     complexity     1 件
 *     correctness   17 件
 *     nursery       23 件
 *     performance    6 件
 *     security       6 件
 *     source         4 件
 *     style          9 件
 *     suspicious    13 件
 */
{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",

  // このファイルはプロジェクトのルートではなく、ルートの biome.jsonc を継承する。
  "root": false,
  "extends": "//",

  "linter": {
    "rules": {
      // 既定ではどのルールも有効にしない。ここから下の overrides で 1 つずつ有効化する。
      "preset": "none",

      // ここから下は「打ち消し」の設定です。
      // ルートの biome.jsonc で linter.domains の project / types を "all" にしているのは、
      // プロジェクトスキャナと型推論という *機能* を立ち上げるためです
      // (overrides でルールを有効にしただけでは、これらの機能は動きません)。
      // ただしそのままだと該当ドメインのルールが全 fixture に混入してしまうため、
      // ここで明示的に "off" にして黙らせています。
      // 明示的な "off" は domains の "all" より優先され、さらに overrides の "error" が最優先です。
      "nursery": {
        "noBaseToString": "off",
        "noFloatingPromises": "off",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noUndeclaredClasses": "off",
        "noUnsafePlusOperands": "off",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "useAwaitThenable": "off",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "off",
        "useIncludes": "off",
        "useNullishCoalescing": "off",
        "useRegexpExec": "off",
        "useStringStartsEndsWith": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      },
      "correctness": {
        "noPrivateImports": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off"
      },
      "complexity": {
        "useArrayFind": "off"
      },
      "style": {
        "useConsistentEnumValueType": "off"
      },
    }
  },

  // ここから下が「どのディレクトリでどのルールを有効にするか」の一覧です。
  "overrides": [
    // ══════════════════════════════════════════════════════════════════════════
    // a11y — override 38 件
    // ══════════════════════════════════════════════════════════════════════════
    // noAccessKey — Enforce that the `accessKey` attribute is not used on any HTML element.
    //   縛る対象 : src/a11y/noAccessKey/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/a11y/noAccessKey を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-access-key/
    {
      "includes": ["**/src/a11y/noAccessKey/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noAccessKey": "error" } } }
    },

    // noAmbiguousAnchorText — Disallow ambiguous anchor descriptions.
    //   縛る対象 : src/a11y/noAmbiguousAnchorText/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/a11y/noAmbiguousAnchorText を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-ambiguous-anchor-text/
    {
      "includes": ["**/src/a11y/noAmbiguousAnchorText/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noAmbiguousAnchorText": "error" } } }
    },

    // noAmbiguousAnchorText — Disallow ambiguous anchor descriptions.
    //   縛る対象 : src/a11y/noAmbiguousAnchorText/options-1/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/a11y/noAmbiguousAnchorText を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正なし
    //   オプション: 既定ではなく下の "options" の設定で検証する
    //   ドキュメント: https://biomejs.dev/linter/rules/no-ambiguous-anchor-text/
    {
      "includes": ["**/src/a11y/noAmbiguousAnchorText/options-1/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "a11y": { "noAmbiguousAnchorText": { "level": "error", "options": { "words": ["click this"] } } }
        }
      }
    },

    // noAriaHiddenOnFocusable — Enforce that aria-hidden="true" is not set on focusable elements.
    //   縛る対象 : src/a11y/noAriaHiddenOnFocusable/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/a11y/noAriaHiddenOnFocusable を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-aria-hidden-on-focusable/
    {
      "includes": ["**/src/a11y/noAriaHiddenOnFocusable/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noAriaHiddenOnFocusable": "error" } } }
    },

    // noAriaUnsupportedElements — Enforce that elements that do not support ARIA roles, states, and properties do not have those attributes.
    //   縛る対象 : src/a11y/noAriaUnsupportedElements/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/a11y/noAriaUnsupportedElements を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-aria-unsupported-elements/
    {
      "includes": ["**/src/a11y/noAriaUnsupportedElements/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noAriaUnsupportedElements": "error" } } }
    },

    // noAutofocus — Enforce that autoFocus prop is not used on elements.
    //   縛る対象 : src/a11y/noAutofocus/default/ 配下 (4 ケース / 4 ファイル)
    //   有効化   : lint/a11y/noAutofocus を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-autofocus/
    {
      "includes": ["**/src/a11y/noAutofocus/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noAutofocus": "error" } } }
    },

    // noDistractingElements — Enforces that no distracting elements are used.
    //   縛る対象 : src/a11y/noDistractingElements/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/a11y/noDistractingElements を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-distracting-elements/
    {
      "includes": ["**/src/a11y/noDistractingElements/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noDistractingElements": "error" } } }
    },

    // noHeaderScope — The scope prop should be used only on `<th>` elements.
    //   縛る対象 : src/a11y/noHeaderScope/default/ 配下 (2 ケース / 2 ファイル)
    //   有効化   : lint/a11y/noHeaderScope を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-header-scope/
    {
      "includes": ["**/src/a11y/noHeaderScope/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noHeaderScope": "error" } } }
    },

    // noInteractiveElementToNoninteractiveRole — Enforce that non-interactive ARIA roles are not assigned to interactive HTML elements.
    //   縛る対象 : src/a11y/noInteractiveElementToNoninteractiveRole/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/a11y/noInteractiveElementToNoninteractiveRole を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
    //   ドキュメント: https://biomejs.dev/linter/rules/no-interactive-element-to-noninteractive-role/
    {
      "includes": ["**/src/a11y/noInteractiveElementToNoninteractiveRole/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noInteractiveElementToNoninteractiveRole": "error" } } }
    },

    // noLabelWithoutControl — Enforce that a label element or component has a text label and an associated input.
    //   縛る対象 : src/a11y/noLabelWithoutControl/default/ 配下 (6 ケース / 6 ファイル)
    //   有効化   : lint/a11y/noLabelWithoutControl を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正なし
    //   ドキュメント: https://biomejs.dev/linter/rules/no-label-without-control/
    {
      "includes": ["**/src/a11y/noLabelWithoutControl/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noLabelWithoutControl": "error" } } }
    },

    // noNoninteractiveElementInteractions — Disallow use event handlers on non-interactive elements.
    //   縛る対象 : src/a11y/noNoninteractiveElementInteractions/default/ 配下 (1 ケース / 1 ファイル)
