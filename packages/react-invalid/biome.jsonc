    {
      "includes": ["**/src/a11y/noRedundantAlt/default/**"],
      "linter": { "enabled": true, "rules": { "a11y": { "noRedundantAlt": "error" } } }
    },

    // noRedundantRoles — Enforce explicit `role` property is not the same as implicit/default role property on an element.
    //   縛る対象 : src/a11y/noRedundantRoles/default/ 配下 (3 ケース / 3 ファイル)
    //   有効化   : lint/a11y/noRedundantRoles を "error" にする
    //   ルール情報: 既定の重大度 error ・ recommended ・ 自動修正 unsafe
