/**
 * @biome-tutorial/astro-invalid の Biome 設定
 * tools/generate.mjs が生成しています。直接編集しないでください。
 *
 * ■ このパッケージが保証すること
 *     biome check がかならず失敗する (しかも有効にしたルールの診断しか出ない)
 *
 * ■ 何を有効にしているか
 *     - 既定ではルールを 1 つも有効にしない      … linter.rules.preset: "none"
 *     - ディレクトリごとに 1 ルールだけ有効にする … overrides[]
 *     - 有効化しているルール: 2 種類 / override: 2 件
 *     - 検証しているケース  : 2 件 (2 ファイル)
 *
 * ■ 何を縛っているか
 *     overrides[].includes に書いたディレクトリだけが、そのルールの検査対象になります。
 *     1 ディレクトリ = 1 ルールなので、「そのルールの診断が出た」ことと「他のルールの診断が出ていない」ことを同時に検証できます。
 *
 * ■ 内訳 (グループごとの override 件数)
 *     nursery        2 件
 */
{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",

  // このファイルはプロジェクトのルートではなく、ルートの biome.jsonc を継承する。
  "root": false,
  "extends": "//",

  "linter": {
    "rules": {
      // 既定ではどのルールも有効にしない。ここから下の overrides で 1 つずつ有効化する。
      "preset": "none",

      // ここから下は「打ち消し」の設定です。
      // ルートの biome.jsonc で linter.domains の project / types を "all" にしているのは、
      // プロジェクトスキャナと型推論という *機能* を立ち上げるためです
      // (overrides でルールを有効にしただけでは、これらの機能は動きません)。
      // ただしそのままだと該当ドメインのルールが全 fixture に混入してしまうため、
      // ここで明示的に "off" にして黙らせています。
      // 明示的な "off" は domains の "all" より優先され、さらに overrides の "error" が最優先です。
      "nursery": {
        "noBaseToString": "off",
        "noFloatingPromises": "off",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noUndeclaredClasses": "off",
        "noUnsafePlusOperands": "off",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "useAwaitThenable": "off",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "off",
        "useIncludes": "off",
        "useNullishCoalescing": "off",
        "useRegexpExec": "off",
        "useStringStartsEndsWith": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      },
      "correctness": {
        "noPrivateImports": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off"
      },
      "complexity": {
        "useArrayFind": "off"
      },
      "style": {
        "useConsistentEnumValueType": "off"
      },
    }
  },

  // ここから下が「どのディレクトリでどのルールを有効にするか」の一覧です。
  "overrides": [
    // ══════════════════════════════════════════════════════════════════════════
    // nursery — override 2 件
    // ══════════════════════════════════════════════════════════════════════════
    // useAstroClientOnlyDirectiveValue — Require a value for Astro's `client:only` directive.
    //   縛る対象 : src/nursery/useAstroClientOnlyDirectiveValue/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/nursery/useAstroClientOnlyDirectiveValue を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正なし ・ ドメイン astro
    //   ドキュメント: https://biomejs.dev/linter/rules/use-astro-client-only-directive-value/
    {
      "includes": ["**/src/nursery/useAstroClientOnlyDirectiveValue/default/**"],
      "linter": { "enabled": true, "rules": { "nursery": { "useAstroClientOnlyDirectiveValue": "error" } } }
    },

    // useScopedStyles — Enforce that `<style>` blocks in Vue SFCs have the `scoped` attribute and that `<style>` blocks in Astro components do not have the `is:global` directive.
    //   縛る対象 : src/nursery/useScopedStyles/default/ 配下 (1 ケース / 1 ファイル)
    //   有効化   : lint/nursery/useScopedStyles を "error" にする
    //   ルール情報: 既定の重大度 info ・ recommended ではない ・ 自動修正 unsafe ・ ドメイン vue
    //   ドキュメント: https://biomejs.dev/linter/rules/use-scoped-styles/
    {
      "includes": ["**/src/nursery/useScopedStyles/default/**"],
      "linter": { "enabled": true, "rules": { "nursery": { "useScopedStyles": "error" } } }
    }

  ]
}
